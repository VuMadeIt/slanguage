# Public (safe in the browser bundle)
NEXT_PUBLIC_VIDEO_BASE_URL=https://cdn.example.com/slanguage/videos
# Point at /generated (or upload public/generated to a CDN) after running
# `npm run generate:assets -- --run`, then set USE_MOCK_VIDEOS=false.
NEXT_PUBLIC_USE_MOCK_VIDEOS=true
# Draw un-generated beats as cutout art instead of unrelated stock footage.
NEXT_PUBLIC_USE_SCENE_ART=true
NEXT_PUBLIC_AI_PROVIDER=mock
NEXT_PUBLIC_SHOW_STORY_DEVTOOLS=true

# Server-only (never prefix with NEXT_PUBLIC_)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# ElevenLabs — funny high-school dialogue over silent Higgsfield video
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_v3
ELEVENLABS_VOICE_ARI=
ELEVENLABS_VOICE_DEZ=
ELEVENLABS_VOICE_PRIYA=
ELEVENLABS_VOICE_TYLER=
ELEVENLABS_VOICE_TEACHER=
ELEVENLABS_VOICE_CONTROL=
# Use a licensed/original dramatic rapper voice; do not clone a real person.
ELEVENLABS_VOICE_KANYE=
ELEVENLABS_VOICE_MANAGER=
ELEVENLABS_VOICE_SECURITY=

# Higgsfield AI — text-to-video for each story beat
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_BASE=https://api.higgsfield.ai/v1
HIGGSFIELD_MODEL=default
